# Copy to .env.local (local) or set in your host's dashboard (Vercel/Netlify).

# Public origin of the site — used for canonical URLs, the sitemap and structured data.
# plavhotel.com is a placeholder until the hotel's real domain is confirmed.
NEXT_PUBLIC_SITE_URL=https://plavhotel.com

# Where form submissions are sent as JSON (e.g. a Zapier/Make webhook that emails
# reservations, posts to Slack or feeds a CRM). Leave empty and they are only
# written to the server log — set this before launch.
ENQUIRY_WEBHOOK_URL=
